{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/nessim-liamani/ooxml-behavioral-intelligence/compatibility-tests/case.schema.json",
  "title": "OOXML compatibility case (schema v1.1)",
  "description": "Machine-readable definition of case.yaml. Human-readable guide: compatibility-tests/schema.md",
  "type": "object",
  "additionalProperties": false,
  "required": ["case-id", "title", "format", "feature", "severity", "status", "reference", "comparisons"],
  "properties": {
    "case-id": {
      "type": "string",
      "pattern": "^(DOCX|XLSX|PPTX)(-[A-Z0-9]+)+-[0-9]{4}$",
      "description": "FORMAT-FEATURE-NNNN; must match the directory name and the format/feature fields."
    },
    "title": { "type": "string", "minLength": 10, "maxLength": 140 },
    "format": { "enum": ["docx", "xlsx", "pptx"] },
    "feature": {
      "enum": [
        "numbering", "styles", "tables", "images", "headers-footers", "fields", "charts",
        "formulas", "pivots", "conditional-format", "slide-layouts", "animations", "themes",
        "metadata", "legacy", "extensions", "other"
      ]
    },
    "severity": { "enum": ["critical", "high", "medium", "low"] },
    "status": { "enum": ["confirmed", "unconfirmed", "regression", "fixed"] },
    "reference": { "$ref": "#/$defs/reference" },
    "comparisons": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/comparison" }
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "anonymized", "synthetic"],
      "properties": {
        "source": { "$ref": "#/$defs/relpath" },
        "anonymized": { "const": true, "description": "Contributions must be anonymized (docs/DATA_POLICY.md)." },
        "synthetic": { "type": "boolean" },
        "description": { "type": "string" }
      }
    },
    "evidence": { "type": "array", "items": { "$ref": "#/$defs/relpath" }, "uniqueItems": true },
    "contributor": { "type": "string", "minLength": 1 },
    "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "tags": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "related": {
      "type": "array",
      "items": { "type": "string", "pattern": "^(DOCX|XLSX|PPTX)(-[A-Z0-9]+)+-[0-9]{4}$" },
      "uniqueItems": true
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "confirmed" } }, "required": ["status"] },
      "then": {
        "description": "A confirmed case needs captured outputs from a verified reference and every comparison.",
        "required": ["document"],
        "properties": {
          "reference": { "required": ["output", "verified"], "properties": { "verified": { "const": true } } },
          "comparisons": { "items": { "required": ["output"] } }
        }
      }
    }
  ],
  "$defs": {
    "relpath": {
      "type": "string",
      "pattern": "^(?!/)(?!.*\\.\\.)[^\\\\]+$",
      "description": "Path relative to the case directory; no absolute paths or '..'."
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["implementation", "version"],
      "properties": {
        "implementation": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "platform": { "type": "string" },
        "output": { "$ref": "#/$defs/relpath" },
        "verified": {
          "type": "boolean",
          "description": "True only if the behaviour was captured from the named implementation. False when the reference is the written specification."
        }
      }
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": ["implementation", "version"],
      "properties": {
        "implementation": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "platform": { "type": "string" },
        "output": { "$ref": "#/$defs/relpath" },
        "notes": { "type": "string" }
      }
    }
  }
}
